# Copy this file to .env.
# If PIXOO_HOST is omitted, the PoC will try Divoom's same-LAN discovery API.
PIXOO_HOST=192.168.151.248

# Optional: required only when the LAN discovery API returns multiple Divoom devices.
# PIXOO_DEVICE_NAME=Pixoo-64

# Optional: V4 upload strategy for animation experiment.
# sequential: send one frame per request with PicOffset increment (default)
# batched: send concatenated frames in one request (legacy experiment)
V4_UPLOAD_MODE=sequential
