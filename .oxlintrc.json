{
  "$schema": "https://oxc.rs/schema/oxlintrc.json",
  "env": {
    "node": true,
    "es2024": true
  },
  "globals": {},
  "settings": {},
  "rules": {
    "oxc/no-unused-vars": "error",
    "oxc/no-constant-condition": "warn",
    "oxc/no-debugger": "error",
    "oxc/no-empty": "warn",
    "oxc/no-empty-pattern": "error",
    "oxc/no-unreachable": "error",
    "oxc/no-irregular-whitespace": "error",
    "suspicious/no-assigning-to-function-parameters": "error",
    "suspicious/no-await-in-loop": "warn",
    "suspicious/no-implicit-any-let": "error",
    "suspicious/no-mismatched-else-if": "warn",
    "suspicious/no-shadowed-variable": "error",
    "suspicious/no-typeof-undefined": "error",
    "suspicious/no-unsafe-finally": "error",
    "complexity/no-excessive-cognitive-complexity": "warn",
    "correctness/no-const-assign": "error",
    "correctness/no-duplicate-key": "error",
    "correctness/no-loss-of-precision": "error",
    "correctness/no-obj-calls": "error",
    "correctness/no-setter-return": "error",
    "correctness/no-undeclared-variables": "error",
    "correctness/no-unreachable-code": "error",
    "correctness/use-isnan": "error",
    "unicorn/catch-error-name": "warn",
    "unicorn/error-message": "error",
    "unicorn/escape-case": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-new-array": "error",
    "unicorn/no-new-buffer": "error",
    "unicorn/prefer-array-find": "warn",
    "unicorn/prefer-string-slice": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "out/**",
    "node_modules/**",
    ".next/**",
    "coverage/**"
  ]
}
