{
  "name": "glance-pixel",
  "version": "0.1.0",
  "private": true,
  "description": "Custom information display service for Divoom Pixoo 64 and other pixel-based devices",
  "license": "MIT",
  "author": "tomo-waka",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^0.7.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
