{
  "name": "glance-pixel",
  "version": "0.1.0",
  "description": "Custom information display service for Divoom Pixoo 64 and other pixel-based devices",
  "license": "MIT",
  "author": "tomo-waka",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  }
}
